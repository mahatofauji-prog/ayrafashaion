rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.size() > 0;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection endpoint
    match /test/connection {
      allow read: if true;
    }

    // Business profile collection
    match /businesses/{businessId} {
      allow read: if isValidId(businessId);
      allow create, update: if isSignedIn() && isValidId(businessId);
      allow delete: if isSignedIn() && isValidId(businessId);
    }

    // Category collection
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(categoryId);
      allow delete: if isSignedIn() && isValidId(categoryId);
    }

    // Products collection
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(productId);
      allow delete: if isSignedIn() && isValidId(productId);
    }
  }
}
